      "label": { "en": "H\u1ed3n D\u00ednh M\u00e1u", "zh-Hans": "\u9b42\u8eab\u4e0a\u67d3\u8840", "zh-Hant": "\u9b42\u8eab\u4e0a\u67d3\u8840" },
