        "zh-Hant": "\u9069\u7528\u65bc\u9577\u9aee\uff08\u5e03\u6599\u6a21\u64ec\u7684\u982d\u9aee\uff09\u7684\u982d\u9871\uff0c\u9019\u985e\u982d\u9871\u4e0d\u6703\u4ee5\u5149\u982d\u7684\u6a23\u5b50\u98db\u51fa\u3002\u7206\u88c2\uff1a\u982d\u9871\u70b8\u6210\u9871\u9aa8\u788e\u7247\u8207\u788e\u8089\u3002\u9023\u540c\u982d\u9aee\u98db\u51fa\uff1a\u982d\u9871\u9023\u8457\u982d\u9aee\u6574\u500b\u98db\u51fa\uff1b\u982d\u9aee\u7121\u6cd5\u4e00\u8d77\u5e36\u8d70\u6642\u5247\u7206\u88c2\u3002" } },
